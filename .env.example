# Öffentliche Frontend-Konfiguration. Diese Werte dürfen im Browser verwendet werden.
VITE_SUPABASE_URL=<DEINE_SUPABASE_PROJECT_URL>
VITE_SUPABASE_PUBLISHABLE_KEY=<DEIN_SUPABASE_PUBLIC_ODER_PUBLISHABLE_KEY>
VITE_APP_URL=http://localhost:5173
VITE_DEMO_MODE=true

# NUR SERVERSEITIG als Supabase Edge Function Secrets setzen – niemals mit VITE_ prefix verwenden:
# OPENAI_API_KEY=<SECRET>
# OPENAI_MODEL=gpt-4.1-mini
# ALLOWED_ORIGIN=https://<DEINE-PAGES-DOMAIN>
# EMAIL_INGEST_SECRET=<LANGES_ZUFAELLIGES_SECRET>
# PLATFORM_ADMIN_EMAIL=<DEINE_ADMIN_EMAIL>
